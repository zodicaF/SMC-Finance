{
  "name": "transfer-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bank transfer request tracker. Plain JavaScript, no framework, no build step.",
  "scripts": {
    "dev": "serve public -l 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "tsc --noEmit -p jsconfig.json",
    "fonts": "node scripts/copy-fonts.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
